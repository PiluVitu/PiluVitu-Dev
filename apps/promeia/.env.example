# Token que protege TODA rota do promeia. Sem ele o serviço NÃO SOBE.
# O túnel torna este serviço alcançável pela internet inteira — sem token,
# é GPU grátis publicada. Gere com: openssl rand -base64 32
PROMEIA_TOKEN=

# Ollama local. O modelo é carregado sob demanda pelo próprio Ollama.
OLLAMA_URL=http://localhost:11434
# Instalados nesta máquina hoje: qwen3.5:4b, qwen3.5:9b, gemma4:12b,
# qwen2.5:3b-instruct e qwen2.5:7b-instruct.
#
# ⚠️ OLLAMA_MODEL é SÓ do insight, e fica no 7b-instruct de propósito: o
# gargalo medido dele é o prompt, não o modelo. Calhar de ser o mesmo valor de
# MODEL_PROOFREAD é coincidência — os dois foram decididos separado.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Revisão de artigo — três slots independentes. Defaults MEDIDOS pelo caminho
# REAL do proofread (um bloco por chamada, que é como ele roda): preservação do
# nível do título em 9 repetições — gemma4:12b 9/9, qwen2.5:7b-instruct 9/9,
# qwen2.5:3b-instruct 6/9, qwen3.5:9b 4/9, qwen3.5:4b 1/9.
# ⚠️ NÃO troque por um qwen3.5 "mais novo": ele devolve '# Subtítulo' no lugar
# de '## Subtitulo' na maioria das vezes, porque o título chega ao modelo
# sozinho. Um corpus de texto INTEIRO não mostra isso — foi assim que a escolha
# errada entrou uma vez (commit 6808f60). Detalhes em src/promeia/config.py.
# ⚠️ gemma4:12b é modelo de RACIOCÍNIO: só funciona porque o promeia manda
# "think": false no payload (ver o cabeçalho de src/promeia/ollama.py). Modelo
# sem thinking (qwen2.5) ignora o campo — os dois convivem sem fallback.
MODEL_PROOFREAD=qwen2.5:7b-instruct
MODEL_PROOFREAD_CAREFUL=gemma4:12b
MODEL_HOOKS=gemma4:12b

# ramielle — para onde o promeia EMPURRA o resultado. Hoje é o Worker de
# finanças; o INGEST_TOKEN é o mesmo do `wrangler secret put INGEST_TOKEN`
# (ou a chave INGEST_TOKEN de apps/financas/.dev.vars em dev).
RAMIELLE_URL=https://financas.piluvitu.com.br
INGEST_TOKEN=

{
  "name": "@piluvitu/financas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:web && wrangler dev",
    "deploy": "pnpm run build:web && wrangler deploy",
    "build:web": "pnpm --filter @piluvitu/financas-web build",
    "lint": "tsc --noEmit",
    "pretest": "pnpm --filter @piluvitu/financas-web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply piluvitu-financas --local",
    "db:migrate:remote": "wrangler d1 migrations apply piluvitu-financas --remote",
    "db:migrate:list:local": "wrangler d1 migrations list piluvitu-financas --local",
    "db:migrate:list:remote": "wrangler d1 migrations list piluvitu-financas --remote",
    "backup": "./scripts/backup-d1.sh",
    "backup:test": "./scripts/backup-d1.test.sh",
    "pdf-import": "node scripts/pdf-import.mjs",
    "test:pdf-import": "vitest run --config vitest.scripts.config.ts"
  },
  "dependencies": {
    "@piluvitu/tools": "workspace:*",
    "better-auth": "1.6.25",
    "hono": "^4.12.32",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}

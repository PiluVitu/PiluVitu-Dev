{
  "account_id": "c52a9959db02d735ef489d9728ccf4de",

  // Custom Domain e OBRIGATORIO, nao preferencia: o Cloudflare Access so
  // protege hostname de uma zona da conta, e *.workers.dev nao e uma. Sem
  // isso nao ha como pos a policy na frente do Worker.
  "routes": [{ "pattern": "financas.piluvitu.com.br", "custom_domain": true }],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piluvitu-financas",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Medido (spike S3): NÃO é obrigatório para este stack subir ou rodar
  // nesta compatibility_date — node:crypto e node:async_hooks já são
  // módulos nativos do runtime aqui. O flag silencia 2 warnings de build
  // do wrangler ("wasn't found on the file system but is built into
  // node") e protege contra o comportamento não ser garantido em
  // compatibility_date/versões de workerd futuras.
  //
  // ⚠️ O efeito desta flag NÃO foi reconfirmado dentro deste pacote. Até a
  // Task 3, nada em src/ importa src/lib/auth.ts, então o better-auth
  // (única fonte de imports `node:` aqui) sai inteiro no tree-shaking e os
  // 2 warnings não apareceriam NEM COM NEM SEM a flag — um dry-run limpo
  // não prova nada sobre ela. A medição de verdade (tamanho do bundle e
  // presença dos warnings) é a Step 12 da Task 3, com o import ligado.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static Assets é GRÁTIS, ilimitado e FORA da cota de 100.000 requests/dia.
  // 'run_worker_first' é o que garante, de forma documentada, que /api/* chega
  // no Worker em vez de ser engolido pelo fallback de SPA. Sem ele, a ordem de
  // avaliação entre asset e Worker fica implícita, e o erro só apareceria em
  // produção.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piluvitu-financas",
      "database_id": "6d16f807-53d2-43e5-900e-5b1c095a7045",
      "migrations_dir": "migrations",
    },
  ],

  "vars": {
    "ACCESS_TEAM_DOMAIN": "piluvitu.cloudflareaccess.com",
    "ACCESS_AUD": "trocar-pelo-aud-tag-da-application-do-access",

    // ⚠️ ESTE PLACEHOLDER SOBREVIVE ATÉ A TASK 15. Nada entre aqui e lá
    // falha se ele ficar como está — o middleware só compara `aud` em
    // runtime, e os testes usam um aud sintético. Antes de qualquer
    // `wrangler deploy`, confira: o valor tem que ser o Application Audience
    // (AUD) Tag da Application do Access, 64 hex. Se ainda estiver com o
    // texto do placeholder, TODA requisição de produção vai cair em 401
    // invalid_audience (ver o mapeamento de status em requireAccess, em
    // src/lib/access.ts) — e o sintoma parece problema de login, não de config.
    "ACCESS_ALLOWED_EMAILS": "paulo.tspi@gmail.com",
  },
}
